# Salin ke .env.local lalu isi. Dibaca oleh "pnpm aos".
AOS_ROUTER_URL=http://127.0.0.1:20128/v1
AOS_ROUTER_KEY=
AOS_TIMEZONE=Asia/Jakarta
# Tulis path lengkap; %VAR% tidak di-expand.
# Opsional, jika HERMES_HOME tidak di %LOCALAPPDATA%\hermes
# AOS_HERMES_HOME=

# Opsional: arahkan tier ke model/combo 9Router lain (default = nama tier)
# AOS_TIER_MODEL_OS_BRAIN=os-brain
# AOS_TIER_MODEL_OS_WORKER=os-worker
# AOS_TIER_MODEL_OS_PRIVATE=os-private
